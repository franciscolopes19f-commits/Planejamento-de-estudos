# Copie para .env (ou configure no painel da hospedagem). Nunca publique este arquivo preenchido.

# Acesso inicial ao painel (usado só na primeira execução, quando ainda não há usuário)
ADMIN_EMAIL=dono@nutauro.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Servidor
PORT=3000
DATA_DIR=./data                 # banco SQLite e fotos enviadas — precisa ser um disco PERSISTENTE
PUBLIC_URL=https://loja.seudominio.com.br
NODE_ENV=production
COOKIE_SECURE=1                 # use 1 quando o site estiver em HTTPS

# Produtos de demonstração na primeira execução (0 = não criar)
SEED_DEMO=0

# Pagamento pelo site — Mercado Pago (Checkout Pro: Pix e cartão)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Consulta de código de barras — Cosmos/Bluesoft (opcional)
COSMOS_TOKEN=

# Só para testes: permite o "pagamento de demonstração" mesmo com NODE_ENV=production
# ALLOW_DEMO_PAYMENTS=1
