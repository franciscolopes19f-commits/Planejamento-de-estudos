{
  "name": "nutauro-catalogo",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo digital e loja virtual da Nutauro Suplementos",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/seed-cli.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "build:demo": "node --disable-warning=ExperimentalWarning scripts/build-demo.js"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
